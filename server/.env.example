# Application Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://hikma:hikma123@localhost:5432/hikma"
DB_MAX_RETRIES=3
DB_RETRY_DELAY=2000
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD="redis123"
REDIS_DB=0
REDIS_URL="redis://:redis123@localhost:6379"

# Advanced Redis connection settings (optional)
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_KEEP_ALIVE=30000

# Queue Redis (can be same as main Redis or separate)
QUEUE_REDIS_URL=redis://:redis123@localhost:6379

NEO4J_URL="bolt://localhost:7687"
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_MAX_RETRIES=3
NEO4J_RETRY_DELAY=1000

# Vector Database Configuration
# Pinecone is no longer used - using alternative vector store

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hikma-embeddings
QDRANT_DIMENSION=1536
QDRANT_DISTANCE=Cosine
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_DELAY=1000
QDRANT_TIMEOUT=30000

# LLM API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Alternative LLM Configuration (for Ollama/LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_MODEL=llama2
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# External Service Integrations
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_CLI_PATH=/usr/bin/gh

JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_CLI_PATH=/usr/local/bin/acli

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_ROUNDS=12
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring and Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Queue Configuration
QUEUE_REDIS_URL="redis://:redis123@localhost:6379"
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_REMOVE_COMPLETE=100
QUEUE_REMOVE_FAILED=50
QUEUE_BACKOFF_DELAY=2000

# External Services
# GitHub Integration
GITHUB_TOKEN=""
GITHUB_CLI_PATH="gh"
GITHUB_API_URL="https://api.github.com"
GITHUB_ENABLE_TEMP_CLONING=false
GITHUB_TEMP_CLONE_TIMEOUT=300000

# Jira Integration
JIRA_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_CLI_PATH="/usr/local/bin/acli"

# Slack Integration
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_APP_TOKEN=""

# File Storage
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES=".txt,.md,.json,.yaml,.yml,.csv"
UPLOAD_DIR="./data/uploads"

# Development Configuration
DEV_SEED_DATA=true
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_SQL_QUERIES=false

# Temporary Directory Configuration
TEMP_DIR_BASE_PATH="/tmp/hikma"
TEMP_DIR_MAX_AGE=3600000
TEMP_DIR_CLEANUP_INTERVAL=1800000
TEMP_DIR_MAX_SIZE=1073741824
TEMP_DIR_ENABLE_AUTO_CLEANUP=true

# Database Seeding Configuration
# Production safety - set to true to allow seeding in production (not recommended)
ALLOW_PRODUCTION_SEEDING=false

# Seed User Credentials (leave empty to generate secure random passwords)
SEED_ADMIN_EMAIL=admin@hikma.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@hikma.com
SEED_USER_PASSWORD=
SEED_VIEWER_EMAIL=viewer@hikma.com
SEED_VIEWER_PASSWORD=

