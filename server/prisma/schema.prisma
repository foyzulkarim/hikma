// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  projects    ProjectMember[]
  queryLogs   QueryLog[]
  feedback    Feedback[]
  apiKeys     ApiKey[]

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

// API Key Management
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  userId      String
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// Project Management
model Project {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?
  repositoryUrl String?       @unique
  status        ProjectStatus @default(ACTIVE)
  settings      Json          @default("{}")
  syncInfo      Json?         @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  members       ProjectMember[]
  dataSources   DataSource[]
  queryLogs     QueryLog[]
  syncJobs      SyncJob[]
  knowledgeBase KnowledgeBase[]
  webhooks      Webhook[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ProjectMember {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Data Source Management
model DataSource {
  id          String           @id @default(cuid())
  projectId   String
  name        String
  type        DataSourceType
  config      Json
  status      DataSourceStatus @default(PENDING)
  lastSyncAt  DateTime?
  nextSyncAt  DateTime?
  errorCount  Int              @default(0)
  lastError   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  syncJobs     SyncJob[]
  repositories Repository[]

  @@unique([projectId, name])
  @@map("data_sources")
}

enum DataSourceType {
  GIT
  GITHUB
  JIRA
  SLACK
  CONFLUENCE
  FILE_UPLOAD
}

enum DataSourceStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

// Sync Job Management
model SyncJob {
  id           String        @id @default(cuid())
  projectId    String
  dataSourceId String
  type         SyncJobType
  status       SyncJobStatus @default(PENDING)
  progress     Float         @default(0)
  totalItems   Int?
  processedItems Int?
  errorCount   Int           @default(0)
  errors       Json          @default("[]")
  metadata     Json          @default("{}")
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
}

enum SyncJobType {
  FULL_SYNC
  INCREMENTAL_SYNC
  REINDEX
  CLEANUP
}

enum SyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Knowledge Base - now works with repositories and code chunks
model KnowledgeBase {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("knowledge_bases")
}

// Repository Management
model Repository {
  id               String      @id @default(cuid())
  dataSourceId     String
  name             String
  url              String?
  lastIndexedAt    DateTime?
  indexingVersion  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relationships
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  files      CodeFile[]

  @@index([dataSourceId])
  @@map("repositories")
}

// File tracking with full path indexing
model CodeFile {
  id           String     @id @default(cuid())
  repositoryId String
  filePath     String
  language     String?
  framework    String?
  fileHash     String?    // SHA-256 for change detection
  lineCount    Int?
  sizeBytes    Int?
  lastModified DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunks     CodeChunk[]

  @@unique([repositoryId, filePath])
  @@index([filePath])
  @@index([language])
  @@map("code_files")
}

// Rich code chunks with Tree-sitter metadata
model CodeChunk {
  id              String    @id @default(cuid())
  fileId          String
  parentChunkId   String?   // Self-reference for nested chunks
  
  // Position information
  startLine       Int
  endLine         Int
  startColumn     Int?
  endColumn       Int?
  
  // Content
  codeContent     String
  cleanedContent  String?   // without comments/docstrings for embedding
  
  // Tree-sitter extracted metadata
  nodeType        String    // function, class, method, etc.
  nodeName        String?
  signature       String?   // full signature for functions/methods
  
  // Classification metadata
  purposeCategory String?
  complexityScore Float?
  cognitiveComplexity Int?
  
  // Rich flags
  hasDocstring    Boolean   @default(false)
  hasErrorHandling Boolean  @default(false)
  hasTests        Boolean   @default(false)
  isExported      Boolean   @default(false)
  isAsync         Boolean   @default(false)
  isGenerator     Boolean   @default(false)
  isStatic        Boolean   @default(false)
  
  // Indexing
  embeddingVersion String?
  embeddedAt      DateTime?
  qdrantPointId   String?   @unique
  vectorId        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  file            CodeFile      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parentChunk     CodeChunk?    @relation("ChunkHierarchy", fields: [parentChunkId], references: [id])
  childChunks     CodeChunk[]   @relation("ChunkHierarchy")
  documentation   ChunkDocumentation[]
  tags            ChunkTag[]
  typeDefinitions TypeDefinition[]

  @@index([fileId])
  @@index([nodeType])
  @@index([purposeCategory])
  @@index([complexityScore])
  @@index([parentChunkId])
  @@index([vectorId])
  @@map("code_chunks")
}

// Extracted documentation
model ChunkDocumentation {
  id      String @id @default(cuid())
  chunkId String
  docType String // 'docstring', 'comment', 'jsdoc', 'readme_ref'
  content String
  summary String? // LLM-generated summary
  createdAt DateTime @default(now())

  // Relationships
  chunk CodeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([docType])
  @@map("chunk_documentation")
}

// Domain and semantic tags
model SemanticTag {
  id          String @id @default(cuid())
  name        String @unique
  category    String? // 'domain', 'pattern', 'framework_specific'
  description String?

  // Relationships
  chunks ChunkTag[]

  @@index([category])
  @@map("semantic_tags")
}

model ChunkTag {
  chunkId    String
  tagId      String
  confidence Float  @default(1.0)

  // Relationships
  chunk CodeChunk   @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  tag   SemanticTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([chunkId, tagId])
  @@map("chunk_tags")
}

// Type information for TypeScript/strongly-typed languages
model TypeDefinition {
  id             String  @id @default(cuid())
  chunkId        String
  paramName      String?
  typeDefinition String
  isReturnType   Boolean @default(false)
  isGeneric      Boolean @default(false)

  // Relationships
  chunk CodeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
  @@index([isReturnType])
  @@map("type_definitions")
}

// Query and Response Logging
model QueryLog {
  id          String      @id @default(cuid())
  projectId   String
  userId      String?
  sessionId   String?
  query       String
  intent      String?
  entities    Json        @default("{}")
  pipeline    String?
  response    String?
  status      QueryStatus @default(PENDING)
  duration    Int?
  tokenUsage  Json        @default("{}")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationships
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedback  Feedback[]
  toolCalls ToolCall[]

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("query_logs")
}

enum QueryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Tool Call Logging
model ToolCall {
  id          String   @id @default(cuid())
  queryLogId  String
  toolName    String
  inputs      Json
  outputs     Json?
  duration    Int?
  status      String
  error       String?
  createdAt   DateTime @default(now())

  // Relationships
  queryLog QueryLog @relation(fields: [queryLogId], references: [id], onDelete: Cascade)

  @@map("tool_calls")
}

// Feedback System
model Feedback {
  id         String       @id @default(cuid())
  queryLogId String
  userId     String
  type       FeedbackType
  rating     Int?
  comment    String?
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now())

  // Relationships
  queryLog QueryLog @relation(fields: [queryLogId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queryLogId, userId])
  @@map("feedback")
}

enum FeedbackType {
  THUMBS_UP
  THUMBS_DOWN
  RATING
  COMMENT
}

// Analytics and Metrics
model Metric {
  id        String   @id @default(cuid())
  name      String
  value     Float
  labels    Json     @default("{}")
  timestamp DateTime @default(now())

  @@index([name, timestamp])
  @@map("metrics")
}

// Configuration Storage
model Configuration {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configurations")
}

// Webhook Management
model Webhook {
  id          String        @id @default(cuid())
  projectId   String?
  name        String
  url         String
  secret      String?
  events      String[]
  status      WebhookStatus @default(ACTIVE)
  lastTriggeredAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model WebhookDelivery {
  id          String                @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastAttempt DateTime?
  response    Json?
  createdAt   DateTime              @default(now())

  // Relationships
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

