# Application Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://hikma:hikma123@localhost:5432/hikma"
REDIS_URL="redis://:redis123@localhost:6379"
NEO4J_URL="bolt://localhost:7687"
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123

# Vector Database Configuration
# Pinecone is no longer used - using alternative vector store

# LLM API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Alternative LLM Configuration (for Ollama/LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# External Service Integrations
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_CLI_PATH=/usr/bin/gh

JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_CLI_PATH=/usr/local/bin/acli

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=your-32-character-encryption-key
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Monitoring and Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Queue Configuration
QUEUE_REDIS_URL="redis://:redis123@localhost:6379"
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

# File Storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=.txt,.md,.json,.yaml,.yml

# Development Configuration
DEV_SEED_DATA=true
DEV_MOCK_EXTERNAL_APIS=false
DEV_LOG_SQL_QUERIES=false

# Database Seeding Configuration
# Production safety - set to true to allow seeding in production (not recommended)
ALLOW_PRODUCTION_SEEDING=false

# Seed User Credentials (leave empty to generate secure random passwords)
SEED_ADMIN_EMAIL=admin@hikma.com
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@hikma.com
SEED_USER_PASSWORD=
SEED_VIEWER_EMAIL=viewer@hikma.com
SEED_VIEWER_PASSWORD=

