{
  "name": "hikma-server",
  "version": "1.0.0",
  "description": "Hikma Agentic Code Intelligence Platform - Server",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "build:clean": "rm -rf dist && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset": "prisma migrate reset",
    "migrate:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "docker:build": "docker build -t hikma-server .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "backup": "tsx scripts/backup.ts",
    "deploy": "npm run build && npm run migrate && npm start",
    "setup": "npm install && npm run db:generate && npm run migrate:dev",
    "cli": "tsx tools/cli/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.20.0",
    "fastify": "^4.28.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "pino": "^8.21.0",
    "pino-pretty": "^11.2.2",
    "ioredis": "^5.4.1",
    "neo4j-driver": "^5.24.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "openai": "^4.67.3",
    "langchain": "^0.3.5",
    "@langchain/openai": "^0.3.11",
    "@langchain/community": "^0.3.12",
    "uuid": "^10.0.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "tsc-alias": "^1.8.10",
    "vitest": "^2.1.3",
    "@vitest/ui": "^2.1.3",
    "prisma": "^5.20.0",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ai",
    "code-intelligence",
    "rag",
    "agent",
    "typescript",
    "fastify",
    "prisma",
    "postgresql",
    "vector-database"
  ],
  "author": "Hikma Team",
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "types": "./dist/server.d.ts"
}
